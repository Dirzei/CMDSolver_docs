VARIABLE ITOTALPRESSURE
LOWER: 5000.;
VALUE: 150000.;
UPPER: 300000.;
UNIT: "Pa";
END

VARIABLE ISTATICPRESSURE
LOWER: 1000.;
VALUE: 140000.;
UPPER: 290000.;
UNIT: "Pa";
END

VARIABLE OTOTALPRESSURE
LOWER: 5000.;
VALUE: 150000.;
UPPER: 300000.;
UNIT: "Pa";
END

VARIABLE OSTATICPRESSURE
LOWER: 1000.;
VALUE: 140000.;
UPPER: 290000.;
UNIT: "Pa";
END

PROCEDURE pCPOFT
CALL: CPOFTNOZ;
INPUTS: REAL, REAL, REAL;
OUTPUTS: REAL;
END

