INITIALIZE

PARTM.F060.W = 0.4*(PARTM.F066.AG*SQRT(1.35/287)*PARTM.F060.PT*0.99/SQRT(PARTM.F060.TT*0.95));
PARTM.F160.W = 0.4*(PARTM.F166.AG*SQRT(1.4/287)*PARTM.F160.PT*0.99/SQRT(PARTM.F160.TT*0.95));
