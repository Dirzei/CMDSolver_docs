   FULLM.LOSS.CFJETPIPE = 2*(GEOM.KR/LN(FULLM.F171.RE)*GEOM.GVALUE)^2;
   FULLM.LOSS.CFNOZZLE1 = 2*(GEOM.KR/LN(FULLM.F171.RE)*GEOM.GVALUE)^2;
   FULLM.LOSS.CFNOZZLE2 = 2*(GEOM.KR/LN(FULLM.F171.RE)*GEOM.GVALUE)^2;
ELSE
   FULLM.LOSS.CFJETPIPE = 0;
   FULLM.LOSS.CFNOZZLE1 = 0;
   FULLM.LOSS.CFNOZZLE2 = 0;
ENDIF

IF (GLOBAL.FFSWITCH2.EQ.0)
   FULLM.LOSS.FFJETPIPE = 0;
   FULLM.LOSS.FFNOZ1 = 0;
   FULLM.LOSS.FFNOZ2 = 0;
ELSE
   FULLM.LOSS.FFJETPIPE = FULLM.LOSS.CFJETPIPE*FULLM.F166.RHO/2*(FULLM.F170.VT+1/3*(FULLM.F171.VT-FULLM.F170.VT))^2*FULLM.LOSS.PJETPIPE*GEOM.LJETPIPE;
   FULLM.LOSS.FFNOZ1 = FULLM.LOSS.CFNOZZLE1*FULLM.F166.RHO/2*(FULLM.F171.VT+1/3*(FULLM.F180.VT-FULLM.F171.VT))^2*FULLM.LOSS.PNOZZLE1*GEOM.NOZL1;
   FULLM.LOSS.FFNOZ2 = FULLM.LOSS.CFNOZZLE2*FULLM.F166.RHO/2*(FULLM.F180.VT+1/3*(FULLM.F190.VT-FULLM.F180.VT))^2*FULLM.LOSS.PNOZZLE2*GEOM.NOZL2;
ENDIF

IF (GLOBAL.SWSHEAR.EQ.0)
   FULLM.LOSS.FFSHEAR = 0;
   FULLM.LOSS.FFTOTAL = FULLM.LOSS.FFJETPIPE+FULLM.LOSS.FFNOZ1+FULLM.LOSS.FFNOZ2;
ELSE
   FULLM.LOSS.FFSHEAR = FULLM.RHOAVG*(GEOM.CJ^2)*1/4*FULLM.DELTAV^2*GEOM.MIXERP*(GEOM.LJETPIPE+GEOM.NOZL1+GEOM.NOZL2);
   FULLM.LOSS.FFTOTAL = FULLM.LOSS.FFJETPIPE+FULLM.LOSS.FFNOZ1+FULLM.LOSS.FFNOZ2+FULLM.LOSS.FFSHEAR;
ENDIF

FULLM.F071.FAR = FULLM.F070.FAR;
FULLM.F071.WGR = FULLM.F070.WGR;
FULLM.F071.RGAS = FULLM.F070.RGAS;
FULLM.F071.W = FULLM.F070.W;
FULLM.F071.TT = FULLM.F070.TT;
IF (GLOBAL.FFSWITCH2.EQ.0)
   FULLM.F071.PT = FULLM.F070.PT;
   FULLM.F071.PS = FULLM.F070.PS;
   FULLM.F071.TS = FULLM.F070.TS;
   FULLM.F071.VT = FULLM.F070.VT;
   FULLM.F071.RHO = FULLM.F070.RHO;
ELSE
   FULLM.F071.PT = FULLM.F071.W*SQRT(FULLM.F071.TT)/(SQRT(FULLM.F071.GAMMA/FULLM.F071.RGAS)*FULLM.F071.MN*(1+(FULLM.F071.GAMMA-1)/2*FULLM.F071.MN^2)^(-(FULLM.F071.GAMMA+1)/(2*(FULLM.F071.GAMMA-1))))/FULLM.F071.AG; 
   FULLM.F071.PS = ((1+FULLM.F170.GAMMA*FULLM.F170.MN^2)*FULLM.F170.AG*FULLM.F170.PS+(1+FULLM.F070.GAMMA*FULLM.F070.MN^2)*FULLM.F070.AG*FULLM.F070.PS-FULLM.LOSS.FFTOTAL-(1+FULLM.F171.GAMMA*FULLM.F171.MN^2)*FULLM.F171.AG*FULLM.F171.PS)/((1+FULLM.F071.GAMMA*FULLM.F071.MN^2)*FULLM.F071.AG);
   FULLM.F071.TS = FULLM.F071.TT/(1+(FULLM.F071.GAMMA-1)/2*FULLM.F071.MN^2);
   FULLM.F071.VT = FULLM.F071.MN*SQRT(FULLM.F071.GAMMA*FULLM.F071.RGAS*FULLM.F071.TS);
   FULLM.F071.RHO = FULLM.F071.PT/(FULLM.F071.RGAS*FULLM.F071.TT)*(FULLM.F071.PS/FULLM.F071.PT)^(1/FULLM.F071.GAMMA);
ENDIF
IF (FULLM.F071.PT>FULLM.F071.PS)
   FULLM.F071.MN = SQRT(((FULLM.F071.PT/FULLM.F071.PS)^((FULLM.F071.GAMMA-1)/FULLM.F071.GAMMA)-1)*2/(FULLM.F071.GAMMA-1));
ELSE
   FULLM.F071.MN = FULLM.F070.MN;
ENDIF
FULLM.F071.AG = FULLM.F070.AG;
CALL(FULLM.F071.CPT) = pCPOFT(FULLM.F071.TT, FULLM.F071.WGR, FULLM.F071.FAR);
FULLM.F071.GAMMAT = FULLM.F071.CPT/(FULLM.F071.CPT-FULLM.F071.RGAS);
CALL(FULLM.F071.CPS) = pCPOFT(FULLM.F071.TS, FULLM.F071.WGR, FULLM.F071.FAR);
FULLM.F071.GAMMAS = FULLM.F071.CPS/(FULLM.F071.CPS-FULLM.F071.RGAS);
IF (GLOBAL.STATICSWITCH.EQ.0)
  FULLM.F071.CP = FULLM.F071.CPT;
  FULLM.F071.GAMMA = FULLM.F071.GAMMAT;
ELSE
  FULLM.F071.CP = FULLM.F071.CPS;
  FULLM.F071.GAMMA = FULLM.F071.GAMMAS;
ENDIF
//--------------------------------BLOCK END - STATION 071 Fully Mixed (Core Station) ---------------------------


//--------------------------------BLOCK START - STATION 171 Fully Mixed (Bypass Station) ---------------------------
FULLM.F171.FAR = FULLM.F170.FAR;
FULLM.F171.WGR = FULLM.F170.WGR;
FULLM.F171.RGAS = FULLM.F170.RGAS;
FULLM.F171.W = FULLM.F180.W+FULLM.DWTRULEAK;
FULLM.F171.TT = FULLM.F170.TT;
FULLM.F171.PS = FULLM.F071.PS;
IF (GLOBAL.FFSWITCH2.EQ.0)
   FULLM.F171.PT = FULLM.F170.PT;   
   FULLM.F171.TS = FULLM.F170.TS;
   FULLM.F171.VT = FULLM.F170.VT;
   FULLM.F171.RHO = FULLM.F170.RHO;
ELSE
   FULLM.F171.PT = FULLM.F171.W*SQRT(FULLM.F171.TT)/(SQRT(FULLM.F171.GAMMA/FULLM.F171.RGAS)*FULLM.F171.MN*(1+(FULLM.F171.GAMMA-1)/2*FULLM.F171.MN^2)^(-(FULLM.F171.GAMMA+1)/(2*(FULLM.F171.GAMMA-1))))/FULLM.F171.AG;
   FULLM.F171.TS = FULLM.F171.TT/(1+(FULLM.F171.GAMMA-1)/2*FULLM.F171.MN^2);
   FULLM.F171.VT = FULLM.F171.MN*SQRT(FULLM.F171.GAMMA*FULLM.F171.RGAS*FULLM.F171.TS);
   FULLM.F171.RHO = FULLM.F171.PT/(FULLM.F171.RGAS*FULLM.F171.TT)*(FULLM.F171.PS/FULLM.F171.PT)^(1/FULLM.F171.GAMMA);
ENDIF
IF (FULLM.F171.PT>FULLM.F171.PS)
   FULLM.F171.MN = SQRT(((FULLM.F171.PT/FULLM.F171.PS)^((FULLM.F171.GAMMA-1)/FULLM.F171.GAMMA)-1)*2/(FULLM.F171.GAMMA-1));
ELSE
   FULLM.F171.MN = FULLM.F170.MN;
ENDIF
FULLM.F171.AG = FULLM.F170.AG;
CALL(FULLM.F171.CPT) = pCPOFT(FULLM.F171.TT, FULLM.F171.WGR, FULLM.F171.FAR);
FULLM.F171.GAMMAT = FULLM.F171.CPT/(FULLM.F171.CPT-FULLM.F171.RGAS);
CALL(FULLM.F171.CPS) = pCPOFT(FULLM.F171.TS, FULLM.F171.WGR, FULLM.F171.FAR);
FULLM.F171.GAMMAS = FULLM.F171.CPS/(FULLM.F171.CPS-FULLM.F171.RGAS);
IF (GLOBAL.STATICSWITCH.EQ.0)
  FULLM.F171.CP = FULLM.F171.CPT;
  FULLM.F171.GAMMA = FULLM.F171.GAMMAT;
ELSE
  FULLM.F171.CP = FULLM.F171.CPS;
  FULLM.F171.GAMMA = FULLM.F171.GAMMAS;
ENDIF
FULLM.F171.MU = GLOBAL.REFMU*(FULLM.F171.TS/GLOBAL.TTREF)^(3/2)*(GLOBAL.TTREF+GLOBAL.SC)/(FULLM.F171.TS+GLOBAL.SC);
FULLM.F171.RE = FULLM.F171.RHO*FULLM.F171.VT*GLOBAL.LL/FULLM.F171.MU;
//--------------------------------BLOCK END - STATION 171 Fully Mixed (Bypass Station) ---------------------------


//--------------------------------BLOCK START - STATION 080 Fully Mixed (Core Station) ---------------------------
FULLM.F080.FAR = FULLM.F071.FAR;
FULLM.F080.WGR = FULLM.F071.WGR;
FULLM.F080.RGAS = FULLM.F071.RGAS;
FULLM.F080.TT = FULLM.F071.TT;
FULLM.F080.PT = FULLM.F071.PT;
CALL(FULLM.F080.CPT) = pCPOFT(FULLM.F080.TT, FULLM.F080.WGR, FULLM.F080.FAR);
FULLM.F080.GAMMAT = FULLM.F080.CPT/(FULLM.F080.CPT-FULLM.F080.RGAS);
CALL(FULLM.F080.CPS) = pCPOFT(FULLM.F080.TS, FULLM.F080.WGR, FULLM.F080.FAR);
FULLM.F080.GAMMAS = FULLM.F080.CPS/(FULLM.F080.CPS-FULLM.F080.RGAS);
IF (GLOBAL.STATICSWITCH.EQ.0)
  FULLM.F080.CP = FULLM.F080.CPT;
  FULLM.F080.GAMMA = FULLM.F080.GAMMAT;
ELSE
  FULLM.F080.CP = FULLM.F080.CPS;
  FULLM.F080.GAMMA = FULLM.F080.GAMMAS;
ENDIF
FULLM.F080.TS = FULLM.F080.TT/(1+(FULLM.F080.GAMMA-1)/2*FULLM.F080.MN^2);
FULLM.F080.PCRIT = FULLM.F080.PT/((1+(FULLM.F080.GAMMA-1)/2)^(FULLM.F080.GAMMA/(FULLM.F080.GAMMA-1)));
FULLM.F080.PTQPCRIT = FULLM.F080.PT/FULLM.F080.PCRIT;
FULLM.F080.PTQPAMB = FULLM.F080.PT/AMB.PS;
IF (FULLM.F080.PT>FULLM.F080.PS)
   FULLM.F080.TMPMN = SQRT(((FULLM.F080.PT/FULLM.F080.PS)^((FULLM.F080.GAMMA-1)/FULLM.F080.GAMMA)-1)*2/(FULLM.F080.GAMMA-1));
ELSE
   FULLM.F080.TMPMN = 1;
ENDIF
IF (FULLM.F080.PTQPAMB>=FULLM.F080.PTQPCRIT)
   FULLM.F080.MN = 1;
   FULLM.F080.PS = FULLM.F080.PT*(FULLM.F080.TS/FULLM.F080.TT)^(FULLM.F080.GAMMA/(FULLM.F080.GAMMA-1));
ELSE
   FULLM.F080.MN = FULLM.F080.TMPMN;
   FULLM.F080.PS = AMB.PS;
ENDIF
FULLM.F080.VT = FULLM.F080.MN*SQRT(FULLM.F080.GAMMA*FULLM.F080.RGAS*FULLM.F080.TS);
FULLM.F080.RHO = FULLM.F080.PT/(FULLM.F080.RGAS*FULLM.F080.TT)*(FULLM.F080.PS/FULLM.F080.PT)^(1/FULLM.F080.GAMMA);
FULLM.F080.AG = FULLM.F080.W*SQRT(FULLM.F080.TT)/(FULLM.F080.PT*SQRT(FULLM.F080.GAMMA/FULLM.F080.RGAS)*FULLM.F080.MN*(1+(FULLM.F080.GAMMA-1)/2*FULLM.F080.MN^2)^(-(FULLM.F080.GAMMA+1)/(2*(FULLM.F080.GAMMA-1))));
IF (FULLM.F080.PS<FULLM.F080.PT)
   FULLM.F080.Q = (FULLM.F080.PS/FULLM.F060.PT)^(1/FULLM.F080.GAMMA)*SQRT(2*FULLM.F080.GAMMA/(FULLM.F080.RGAS*(FULLM.F080.GAMMA-1))*(1-(FULLM.F080.PS/FULLM.F060.PT)^((FULLM.F080.GAMMA-1)/FULLM.F080.GAMMA)));
   FULLM.F080.AE = FULLM.F080.W*SQRT(FULLM.F080.TT)/(FULLM.F080.PT*FULLM.F080.Q);
ELSE
   FULLM.F080.Q = 0.1;
   FULLM.F080.AE = FULLM.F080.AG;
ENDIF
FULLM.F080.W = FULLM.F071.W;
//--------------------------------BLOCK END - STATION 080 Fully Mixed (Core Station) ---------------------------


//--------------------------------BLOCK START - STATION 180 Fully Mixed (Bypass Station) ---------------------------
FULLM.F180.FAR = FULLM.F171.FAR;
FULLM.F180.WGR = FULLM.F171.WGR;
