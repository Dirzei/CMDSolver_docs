ENDIF

IF (PARTM.F066.AG.SPEC==FIXED)
   PARTM.F060.AG = PARTM.F066.AG;
   
   FULLM.F060.AG = PARTM.F066.AG;
   FULLM.F066.AG = PARTM.F066.AG;
   FULLM.F070.AG = PARTM.F066.AG*0.9;
   FULLM.F071.AG = PARTM.F066.AG*0.9;
   FULLM.F080.AG = PARTM.F066.AG*0.9;

ENDIF


IF (PARTM.F160.PT.SPEC==FIXED)
   PARTM.F166.PT = PARTM.F160.PT;
   
   PARTM.F160.PS = PARTM.F160.PT*0.9;
   PARTM.F166.PS = PARTM.F160.PT*0.85;
   
   FULLM.F166.PT = PARTM.F160.PT*0.99;
   FULLM.F170.PT = PARTM.F160.PT*0.99;
   FULLM.F171.PT = PARTM.F160.PT*0.99;
   FULLM.F180.PT = PARTM.F160.PT*0.99;

   FULLM.F160.PS = PARTM.F160.PT*0.9;
   FULLM.F166.PS = PARTM.F160.PT*0.9;
   FULLM.F170.PS = PARTM.F160.PT*0.9;
   FULLM.F171.PS = PARTM.F160.PT*0.9;
   FULLM.F180.PS = PARTM.F160.PT*0.9;
   
