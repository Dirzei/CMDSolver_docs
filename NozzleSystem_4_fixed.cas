ENDIF


IF (PARTM.F166.AG.SPEC==FIXED)
   PARTM.F160.AG = PARTM.F166.AG;
   
   FULLM.F160.AG = PARTM.F166.AG;
   FULLM.F166.AG = PARTM.F166.AG;
   FULLM.F170.AG = PARTM.F166.AG*1.05;
   FULLM.F171.AG = PARTM.F166.AG*1.05;
   FULLM.F180.AG = PARTM.F166.AG*1.05;

ENDIF

GEOM.NOZL1 = GEOM.NOZLENGTH*1/3;
GEOM.NOZL2 = GEOM.NOZLENGTH*2/3;

ENDINIT


//--------------------------------BLOCK START - STATION 060 (Core Station) ---------------------------
PARTM.F060.RGAS = GLOBAL.RUNIV*(PARTM.F060.WGR+0.6219811)/((PARTM.F060.WGR+1)*18.01534);
CALL(PARTM.F060.CPT) = pCPOFT(PARTM.F060.TT, PARTM.F060.WGR, PARTM.F060.FAR);
PARTM.F060.GAMMAT = PARTM.F060.CPT/(PARTM.F060.CPT-PARTM.F060.RGAS);
CALL(PARTM.F060.CPS) = pCPOFT(PARTM.F060.TS, PARTM.F060.WGR, PARTM.F060.FAR);
PARTM.F060.GAMMAS = PARTM.F060.CPS/(PARTM.F060.CPS-PARTM.F060.RGAS);
IF (GLOBAL.STATICSWITCH.EQ.0)
  PARTM.F060.CP = PARTM.F060.CPT;
  PARTM.F060.GAMMA = PARTM.F060.GAMMAT;
ELSE
  PARTM.F060.CP = PARTM.F060.CPS;
  PARTM.F060.GAMMA = PARTM.F060.GAMMAS;
ENDIF
PARTM.F060.W = PARTM.F066.W;
IF (PARTM.F060.PS<PARTM.F060.PT)
   PARTM.F060.Q = (PARTM.F060.PS/PARTM.F060.PT)^(1/PARTM.F060.GAMMA)*SQRT(2*PARTM.F060.GAMMA/(PARTM.F060.RGAS*(PARTM.F060.GAMMA-1))*(1-(PARTM.F060.PS/PARTM.F060.PT)^((PARTM.F060.GAMMA-1)/PARTM.F060.GAMMA)));
ELSE
   PARTM.F060.Q = 0.02;
ENDIF
PARTM.F060.WMAX = (PARTM.F060.AG*SQRT(PARTM.F060.GAMMA/PARTM.F060.RGAS)*PARTM.F060.PS/SQRT(PARTM.F060.TS));
PARTM.F060.AG = PARTM.F066.AG;
PARTM.F060.PS = PARTM.F060.PT*(PARTM.F060.TS/PARTM.F060.TT)^(PARTM.F060.GAMMA/(PARTM.F060.GAMMA-1));
PARTM.F060.TS = PARTM.F060.TT/(1+(PARTM.F060.GAMMA-1)/2*PARTM.F060.MN^2);
PARTM.F060.MN = PARTM.F060.W/(PARTM.F060.AG*SQRT(PARTM.F060.GAMMA/PARTM.F060.RGAS)*PARTM.F060.PS/SQRT(PARTM.F060.TS));
PARTM.F060.RHO = PARTM.F060.PT/(PARTM.F060.RGAS*PARTM.F060.TT)*(PARTM.F060.PS/PARTM.F060.PT)^(1/PARTM.F060.GAMMA);
PARTM.F060.VT = PARTM.F060.MN*SQRT(PARTM.F060.GAMMA*PARTM.F060.RGAS*PARTM.F060.TS);
//--------------------------------BLOCK END - STATION 060 (Core Station) ---------------------------


//--------------------------------BLOCK START - STATION 160 (Bypass Station) ---------------------------
PARTM.F160.RGAS = GLOBAL.RUNIV*(PARTM.F160.WGR+0.6219811)/((PARTM.F160.WGR+1)*18.01534);
CALL(PARTM.F160.CPT) = pCPOFT(PARTM.F160.TT, PARTM.F160.WGR, PARTM.F160.FAR);
PARTM.F160.GAMMAT = PARTM.F160.CPT/(PARTM.F160.CPT-PARTM.F160.RGAS);
CALL(PARTM.F160.CPS) = pCPOFT(PARTM.F160.TS, PARTM.F160.WGR, PARTM.F160.FAR);
PARTM.F160.GAMMAS = PARTM.F160.CPS/(PARTM.F160.CPS-PARTM.F160.RGAS);
IF (GLOBAL.STATICSWITCH.EQ.0)
  PARTM.F160.CP = PARTM.F160.CPT;
  PARTM.F160.GAMMA = PARTM.F160.GAMMAT;
ELSE
  PARTM.F160.CP = PARTM.F160.CPS;
  PARTM.F160.GAMMA = PARTM.F160.GAMMAS;
ENDIF
PARTM.F160.W = PARTM.F166.W;
IF (PARTM.F160.PS<PARTM.F160.PT)
   PARTM.F160.Q = (PARTM.F160.PS/PARTM.F160.PT)^(1/PARTM.F160.GAMMA)*SQRT(2*PARTM.F160.GAMMA/(PARTM.F160.RGAS*(PARTM.F160.GAMMA-1))*(1-(PARTM.F160.PS/PARTM.F160.PT)^((PARTM.F160.GAMMA-1)/PARTM.F160.GAMMA)));
ELSE
   PARTM.F160.Q = 0.02;
ENDIF
PARTM.F160.WMAX = (PARTM.F160.AG*SQRT(PARTM.F160.GAMMA/PARTM.F160.RGAS)*PARTM.F160.PS/SQRT(PARTM.F160.TS));
PARTM.F160.AG = PARTM.F166.AG;
PARTM.F160.PS = PARTM.F160.PT*(PARTM.F160.TS/PARTM.F160.TT)^(PARTM.F160.GAMMA/(PARTM.F160.GAMMA-1));
PARTM.F160.TS = PARTM.F160.TT/(1+(PARTM.F160.GAMMA-1)/2*PARTM.F160.MN^2);
PARTM.F160.MN = PARTM.F160.W/(PARTM.F160.AG*SQRT(PARTM.F160.GAMMA/PARTM.F160.RGAS)*PARTM.F160.PS/SQRT(PARTM.F160.TS));
PARTM.F160.RHO = PARTM.F160.PT/(PARTM.F160.RGAS*PARTM.F160.TT)*(PARTM.F160.PS/PARTM.F160.PT)^(1/PARTM.F160.GAMMA);
PARTM.F160.VT = PARTM.F160.MN*SQRT(PARTM.F160.GAMMA*PARTM.F160.RGAS*PARTM.F160.TS);

GLOBAL.WTOTAL = PARTM.F060.W+PARTM.F160.W;
//--------------------------------BLOCK END - STATION 060 (Bypass Station) ---------------------------


//--------------------------------BLOCK START - STATION 066 (Core Station) ---------------------------
GEOM.STARTPMIXER = 2*GLOBAL.PIVALUE*GEOM.RMIXERSTART;
GEOM.PCORE = 0.5*(GEOM.STARTPMIXER+GEOM.MIXERP)+2*GLOBAL.PIVALUE*0.5*(GEOM.RBULLETSTART+GEOM.RBULLETEND);
IF (PARTM.F066.RE>0)
   PARTM.F066.CF = 2*(GEOM.KR/LN(PARTM.F066.RE)*GEOM.GVALUE)^2;
ELSE
   PARTM.F066.CF = 0;
ENDIF
IF (GLOBAL.FFSWITCH1.EQ.0)
   PARTM.F066.FF = 0;
ELSE
   PARTM.F066.FF = PARTM.F066.CF*PARTM.F066.RHO*0.5*PARTM.F066.VT^2*GEOM.PCORE*GEOM.LMIXER;
ENDIF
PARTM.F066.PT = (PARTM.F060.PT*PARTM.F060.AG*(1+PARTM.F060.GAMMA*PARTM.F060.MN^2)*(1+(PARTM.F060.GAMMA-1)/2*PARTM.F060.MN^2)^(-PARTM.F060.GAMMA/(PARTM.F060.GAMMA-1))-PARTM.F066.FF)/(PARTM.F066.AG*(1+PARTM.F066.GAMMA*PARTM.F066.MN^2)*(1+(PARTM.F066.GAMMA-1)/2*PARTM.F066.MN^2)^(-PARTM.F066.GAMMA/(PARTM.F066.GAMMA-1)));
PARTM.F066.PS = PARTM.F166.PS;
PARTM.F066.TT = PARTM.F060.TT;
PARTM.F066.TS = PARTM.F066.TT*(PARTM.F066.PS/PARTM.F066.PT)^((PARTM.F066.GAMMA-1)/PARTM.F066.GAMMA);
PARTM.F066.MN = PARTM.F066.W/(PARTM.F066.AG*SQRT(PARTM.F066.GAMMA/PARTM.F060.RGAS)*PARTM.F066.PS/SQRT(PARTM.F066.TS));
IF (PARTM.F066.PS<PARTM.F066.PT)
   PARTM.F066.Q = (PARTM.F066.PS/PARTM.F066.PT)^(1/PARTM.F066.GAMMA)*SQRT(2*PARTM.F066.GAMMA/(PARTM.F060.RGAS*(PARTM.F066.GAMMA-1))*(1-(PARTM.F066.PS/PARTM.F066.PT)^((PARTM.F066.GAMMA-1)/PARTM.F066.GAMMA)));
   PARTM.F066.WX = PARTM.F066.Q*PARTM.F066.AG*PARTM.F066.PT/SQRT(PARTM.F066.TT);
ELSE
   PARTM.F066.Q = 0.02;
   PARTM.F066.WX = PARTM.F070.W;
ENDIF
IF (PARTM.F080.MN<1)
   PARTM.F066.W = PARTM.F066.WX*GEOM.CONDIRATIO;
ELSE
   PARTM.F066.W = PARTM.F066.WX;
ENDIF
CALL(PARTM.F066.CPT) = pCPOFT(PARTM.F066.TT, PARTM.F060.WGR, PARTM.F060.FAR);
PARTM.F066.GAMMAT = PARTM.F066.CPT/(PARTM.F066.CPT-PARTM.F060.RGAS);
CALL(PARTM.F066.CPS) = pCPOFT(PARTM.F066.TS, PARTM.F060.WGR, PARTM.F060.FAR);
PARTM.F066.GAMMAS = PARTM.F066.CPS/(PARTM.F066.CPS-PARTM.F060.RGAS);
IF (GLOBAL.STATICSWITCH.EQ.0)
  PARTM.F066.CP = PARTM.F066.CPT;
  PARTM.F066.GAMMA = PARTM.F066.GAMMAT;
ELSE
  PARTM.F066.CP = PARTM.F066.CPS;
  PARTM.F066.GAMMA = PARTM.F066.GAMMAS;
ENDIF
PARTM.F066.VT = PARTM.F066.MN*SQRT(PARTM.F066.GAMMA*PARTM.F060.RGAS*PARTM.F066.TS);
PARTM.F066.RHO = PARTM.F066.PT/(PARTM.F060.RGAS*PARTM.F066.TT)*(PARTM.F066.PS/PARTM.F066.PT)^(1/PARTM.F066.GAMMA);
PARTM.F066.MU = GLOBAL.REFMU*(PARTM.F066.TS/GLOBAL.TTREF)^(3/2)*(GLOBAL.TTREF+GLOBAL.SC)/(PARTM.F066.TS+GLOBAL.SC);
PARTM.F066.RE = PARTM.F066.RHO*PARTM.F066.VT*GLOBAL.LL/PARTM.F066.MU;
//--------------------------------BLOCK END - STATION 066 (Core Station) ---------------------------


//--------------------------------BLOCK START - STATION 166 (Bypass Station) ---------------------------
GEOM.PFAN = 0.5*(GEOM.STARTPMIXER+GEOM.MIXERP)+2*GLOBAL.PIVALUE*GEOM.RJETPIPE;

IF (PARTM.F166.RE>0)
   PARTM.F166.CF = 2*(GEOM.KR/LN(PARTM.F166.RE)*GEOM.GVALUE)^2;
ELSE
   PARTM.F166.CF = 0;
ENDIF
IF (GLOBAL.FFSWITCH1.EQ.0)
   PARTM.F166.FF = 0;
ELSE
   PARTM.F166.FF = PARTM.F166.CF*PARTM.F166.RHO*0.5*PARTM.F166.VT^2*GEOM.PFAN*GEOM.LMIXER;
ENDIF

PARTM.F166.PT = (PARTM.F160.PT*PARTM.F160.AG*(1+PARTM.F160.GAMMA*PARTM.F160.MN^2)*(1+(PARTM.F160.GAMMA-1)/2*PARTM.F160.MN^2)^(-PARTM.F160.GAMMA/(PARTM.F160.GAMMA-1))-PARTM.F166.FF)/(PARTM.F166.AG*(1+PARTM.F166.GAMMA*PARTM.F166.MN^2)*(1+(PARTM.F166.GAMMA-1)/2*PARTM.F166.MN^2)^(-PARTM.F166.GAMMA/(PARTM.F166.GAMMA-1)));
PARTM.F166.PS = PARTM.F166.PT*(PARTM.F166.TS/PARTM.F166.TT)^(PARTM.F166.GAMMA/(PARTM.F166.GAMMA-1));
PARTM.F166.TT = PARTM.F160.TT;
