FULLM.F180.PT = FULLM.F171.PT;
CALL(FULLM.F180.CPT) = pCPOFT(FULLM.F180.TT, FULLM.F180.WGR, FULLM.F180.FAR);
FULLM.F180.GAMMAT = FULLM.F180.CPT/(FULLM.F180.CPT-FULLM.F180.RGAS);
CALL(FULLM.F180.CPS) = pCPOFT(FULLM.F180.TS, FULLM.F180.WGR, FULLM.F180.FAR);
FULLM.F180.GAMMAS = FULLM.F180.CPS/(FULLM.F180.CPS-FULLM.F180.RGAS);
IF (GLOBAL.STATICSWITCH.EQ.0)
  FULLM.F180.CP = FULLM.F180.CPT;
  FULLM.F180.GAMMA = FULLM.F180.GAMMAT;
ELSE
  FULLM.F180.CP = FULLM.F180.CPS;
  FULLM.F180.GAMMA = FULLM.F180.GAMMAS;
ENDIF
FULLM.F180.TS = FULLM.F180.TT/(1+(FULLM.F180.GAMMA-1)/2*FULLM.F180.MN^2);

FULLM.F180.PCRIT = FULLM.F180.PT/((1+(FULLM.F180.GAMMA-1)/2)^(FULLM.F180.GAMMA/(FULLM.F180.GAMMA-1)));
FULLM.F180.PTQPCRIT = FULLM.F180.PT/FULLM.F180.PCRIT;
FULLM.F180.PTQPAMB = FULLM.F180.PT/AMB.PS;
IF (FULLM.F180.PT>FULLM.F180.PS)
   FULLM.F180.TMPMN = SQRT(((FULLM.F180.PT/FULLM.F180.PS)^((FULLM.F180.GAMMA-1)/FULLM.F180.GAMMA)-1)*2/(FULLM.F180.GAMMA-1));
ELSE
   FULLM.F180.TMPMN = 1;
ENDIF
IF (FULLM.F180.PTQPAMB>=FULLM.F180.PTQPCRIT)
   FULLM.F180.MN = 1;
   FULLM.F180.PS = FULLM.F180.PT*(FULLM.F180.TS/FULLM.F180.TT)^(FULLM.F180.GAMMA/(FULLM.F180.GAMMA-1));
ELSE
   FULLM.F180.MN = FULLM.F180.TMPMN;
   FULLM.F180.PS = AMB.PS;
ENDIF
FULLM.F180.VT = FULLM.F180.MN*SQRT(FULLM.F180.GAMMA*FULLM.F180.RGAS*FULLM.F180.TS);
FULLM.F180.RHO = FULLM.F180.PT/(FULLM.F180.RGAS*FULLM.F180.TT)*(FULLM.F180.PS/FULLM.F180.PT)^(1/FULLM.F180.GAMMA);
FULLM.F180.AG = PARTM.GEOM.ATHROAT-FULLM.F080.AG;
IF (PARTM.F180.PS<PARTM.F180.PT)
   FULLM.F180.Q = (FULLM.F180.PS/FULLM.F160.PT)^(1/FULLM.F180.GAMMA)*SQRT(2*FULLM.F180.GAMMA/(FULLM.F180.RGAS*(FULLM.F180.GAMMA-1))*(1-(FULLM.F180.PS/FULLM.F160.PT)^((FULLM.F180.GAMMA-1)/FULLM.F180.GAMMA)));
   FULLM.F180.AE = FULLM.F180.W*SQRT(FULLM.F180.TT)/(FULLM.F180.PT*FULLM.F180.Q);
ELSE
   FULLM.F180.Q = 0.1;
   FULLM.F180.AE = FULLM.F180.AG;
ENDIF
FULLM.F180.WX = FULLM.F180.AG*FULLM.F180.PT*SQRT(FULLM.F180.GAMMA/FULLM.F180.RGAS)*FULLM.F180.MN*(1+(FULLM.F180.GAMMA-1)/2*FULLM.F180.MN^2)^(-(FULLM.F180.GAMMA+1)/(2*(FULLM.F180.GAMMA-1)))/SQRT(FULLM.F180.TT);
IF (FULLM.F180.MN<1)
   FULLM.F180.W = FULLM.F180.WX*GEOM.CONDIRATIO;
ELSE
   FULLM.F180.W = FULLM.F180.WX;
ENDIF
FULLM.GEOM.AFRAC = FULLM.F180.AE/(FULLM.F180.AE+FULLM.F080.AE);
