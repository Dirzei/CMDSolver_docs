   //PARTM.F160.PS.Upper = AMB.PS*4.5;
   //PARTM.F166.PS.Upper = AMB.PS*4.5;
ENDIF


IF (PARTM.F160.TT.SPEC==FIXED)
   PARTM.F166.TT = PARTM.F160.TT;
   
   PARTM.F160.TS = PARTM.F160.TT*0.95;
   PARTM.F166.TS = PARTM.F160.TT*0.95;
   
   FULLM.F166.TT = PARTM.F160.TT;
   FULLM.F170.TT = (PARTM.F060.TT+PARTM.F160.TT)*0.5*0.95;
   FULLM.F171.TT = (PARTM.F060.TT+PARTM.F160.TT)*0.5*0.95;
   FULLM.F180.TT = (PARTM.F060.TT+PARTM.F160.TT)*0.5*0.95;

   FULLM.F160.TS = PARTM.F160.TT*0.95;
   FULLM.F166.TS = PARTM.F160.TT*0.95;
   FULLM.F170.TS = (PARTM.F060.TT+PARTM.F160.TT)*0.5*0.95;
   FULLM.F171.TS = (PARTM.F060.TT+PARTM.F160.TT)*0.5*0.95;
   FULLM.F180.TS = (PARTM.F060.TT+PARTM.F160.TT)*0.5*0.95;
   
