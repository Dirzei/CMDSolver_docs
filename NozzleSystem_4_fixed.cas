ENDIF

IF (PARTM.F060.TT.SPEC==FIXED)
   PARTM.F066.TT = PARTM.F060.TT;
   
   PARTM.F060.TS = PARTM.F060.TT*0.95;
   PARTM.F066.TS = PARTM.F060.TT*0.95;
   
   FULLM.F066.TT = PARTM.F060.TT;
   FULLM.F070.TT = (PARTM.F060.TT+PARTM.F160.TT)*0.5;
   FULLM.F071.TT = (PARTM.F060.TT+PARTM.F160.TT)*0.5;
   FULLM.F080.TT = (PARTM.F060.TT+PARTM.F160.TT)*0.5;

   FULLM.F060.TS = PARTM.F060.TT*0.95;
   FULLM.F066.TS = PARTM.F060.TT*0.95;
   FULLM.F070.TS = (PARTM.F060.TT+PARTM.F160.TT)*0.5*0.95;
   FULLM.F071.TS = (PARTM.F060.TT+PARTM.F160.TT)*0.5*0.95;
   FULLM.F080.TS = (PARTM.F060.TT+PARTM.F160.TT)*0.5*0.95;
   
   //PARTM.F066.TT.Upper = PARTM.F060.TT*1.5;
   
