PARTM.F166.W = 0.4*(PARTM.F166.AG*SQRT(1.4/287)*PARTM.F160.PT*0.99/SQRT(PARTM.F160.TT*0.95));

FULLM.F060.W = 0.4*(PARTM.F066.AG*SQRT(1.35/287)*PARTM.F060.PT*0.99/SQRT(PARTM.F060.TT*0.95));
FULLM.F066.WX = 0.4*(PARTM.F066.AG*SQRT(1.35/287)*PARTM.F060.PT*0.99/SQRT(PARTM.F060.TT*0.95));
FULLM.F160.W = 0.4*(PARTM.F166.AG*SQRT(1.4/287)*PARTM.F160.PT*0.99/SQRT(PARTM.F160.TT*0.95));
FULLM.F166.W = 0.4*(PARTM.F166.AG*SQRT(1.4/287)*PARTM.F160.PT*0.99/SQRT(PARTM.F160.TT*0.95));
FULLM.F070.W = 0.4*(PARTM.F066.AG*SQRT(1.35/287)*PARTM.F060.PT*0.99/SQRT(PARTM.F060.TT*0.95));
FULLM.F170.W = 0.4*(PARTM.F166.AG*SQRT(1.4/287)*PARTM.F160.PT*0.99/SQRT(PARTM.F160.TT*0.95));
FULLM.F071.W = 0.4*(PARTM.F066.AG*SQRT(1.35/287)*PARTM.F060.PT*0.99/SQRT(PARTM.F060.TT*0.95));
FULLM.F171.W = 0.4*(PARTM.F166.AG*SQRT(1.4/287)*PARTM.F160.PT*0.99/SQRT(PARTM.F160.TT*0.95));
FULLM.F080.W = 0.4*(PARTM.F066.AG*SQRT(1.35/287)*PARTM.F060.PT*0.99/SQRT(PARTM.F060.TT*0.95));
FULLM.F180.WX = 0.4*(PARTM.F166.AG*SQRT(1.4/287)*PARTM.F160.PT*0.99/SQRT(PARTM.F160.TT*0.95));
FULLM.F180.W = 0.4*(PARTM.F166.AG*SQRT(1.4/287)*PARTM.F160.PT*0.99/SQRT(PARTM.F160.TT*0.95));

IF (PARTM.F060.PT.SPEC==FIXED)
   PARTM.F066.PT = PARTM.F060.PT;
   
   PARTM.F060.PS = PARTM.F060.PT*0.85;
   PARTM.F066.PS = PARTM.F060.PT*0.85;
   
   FULLM.F066.PT = PARTM.F060.PT*0.99;
   FULLM.F070.PT = PARTM.F060.PT*0.99;

   FULLM.F060.PS = PARTM.F060.PT*0.85;
   FULLM.F066.PS = PARTM.F060.PT*0.85;
   FULLM.F070.PS = PARTM.F060.PT*0.85;
   FULLM.F071.PS = PARTM.F060.PT*0.85;
   FULLM.F080.PS = PARTM.F060.PT*0.85;
   
   //PARTM.F066.PT.Lower = AMB.PS*1.1;

   //PARTM.F066.PS.Lower = AMB.PS;
   
